{{- $secret := readFile "../private/minikube.yaml" | fromYaml -}}

ingress:
  # The minikube addon is used instead.
  installed: false
  namespace: ingress-nginx

networkPolicies:
  enabled: false

# Common settings

internalDomain: llm-dashboard.local
internalIngressClass: nginx
certManagerClusterIssuer: ca-internal

# Security

podSecurityStandards:
  enabled: true
  labels:
    pod-security.kubernetes.io/enforce: "baseline"
    pod-security.kubernetes.io/enforce-version: "latest"
    pod-security.kubernetes.io/warn: "restricted"
    pod-security.kubernetes.io/warn-version: "latest"
    pod-security.kubernetes.io/audit: "restricted"
    pod-security.kubernetes.io/audit-version: "latest"

security:
  automountServiceAccountToken: false
  podSecurityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containerSecurityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL

# Releases

# LiteLLM Gateway

litellm:
  installed: true
  namespace: "litellm"
  serviceName: "litellm"
  servicePort: 4000
  labels:
      app: litellm
  masterkey: {{ $secret.secrets.litellm.masterKey | quote }}
  saltkey: {{ $secret.secrets.litellm.saltKey | quote }}
  dbPassword: {{ $secret.secrets.litellm.dbPassword | quote }}
  replicaCount: 1
  liteadmin:
    storageSize: 1Gi
    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"
      limits:
        cpu: "1"
        memory: "2Gi"

  initContainer:
    image: mirror.gcr.io/bitnamilegacy/os-shell:12-debian-12-r16

  envVars:
    MODEL_API_BASE: {{ $secret.secrets.inference.url | quote }}
    MODEL_API_KEY: {{ $secret.secrets.inference.key | quote }}

  proxy_config:
    litellm_settings:
      success_callback: ["prometheus"]
      failure_callback: ["prometheus"]
    model_list:
      - model_name: "Local-model"
        litellm_params:
          model: {{ $secret.secrets.inference.llmmodel | quote }}
          api_base: os.environ/MODEL_API_BASE
          api_key: os.environ/MODEL_API_KEY
          timeout: 600
      - model_name: "Local-embeddings"
        litellm_params:
          model: {{ $secret.secrets.inference.embmodel | quote }}
          api_base: os.environ/MODEL_API_BASE
          api_key: os.environ/MODEL_API_KEY
        model_info:
          mode: embedding
    general_settings:
      master_key: os.environ/PROXY_MASTER_KEY
      disable_spend_logs: false
      disable_reset_budget: false
    environment_variables:
      LITELLM_LOCAL_MODEL_COST_MAP: "True"
  externalDb:
    enabled: false
    host: ""
    port: 5432
    database: "litellm"
    username: "litellm"

# AnythingLLM

anythingllm:
  installed: true
  namespace: "anythingllm"
  labels:
      app: anythingllm
  servicePort: ""
  image: {}
  storageSize: 5Gi
  llmProvider: "generic-openai"
  openAiTokenLimit: "32768"
  authToken: {{ $secret.secrets.anythingllm.authToken | quote }}
  jwtSecret: {{ $secret.secrets.anythingllm.jwtSecret | quote }}
  mcpServers:
    enabled: true
    name: "k8s-sre-agent"
    type: "streamable"
    url: "http://sre-agent.agent.svc.cluster.local:8000/mcp"

# Agent

agent:
  installed: true
  namespace: "agent"
  labels:
      app: sre-agent
  servicePort: 8000
  allowedNamespaces:
    - "litellm"
    - "anythingllm"
    - "agent"
  portsBaseline:
    litellm:
      allowed_services:
        - name: "litellm"
          type: "ClusterIP"
          ports: [4000]
        - name: "litellm-postgresql"
          type: "ClusterIP"
          ports: [5432]
        - name: "litellm-postgresql-hl"
          type: "ClusterIP"
          ports: [5432]
      allowed_container_ports: [4000, 5432]
      notes: "Only LiteLLM Proxy (4000) and internal PostgreSQL (5432, including headless service) are permitted. NodePort/LoadBalancer are forbidden."
    anythingllm:
      allowed_services:
        - name: "anythingllm"
          type: "ClusterIP"
          ports: [3001]
      allowed_container_ports: [3001]
      notes: "Only AnythingLLM Web UI (3001) is permitted."
    agent:
      allowed_services:
        - name: "sre-agent"
          type: "ClusterIP"
          ports: [8000]
      allowed_container_ports: [8000]
      notes: "Only SRE Diagnostic Agent FastAPI/MCP server (8000) is permitted."

# Monitoring

monitoring:
  enabled: false
  prometheusReleaseLabel: "prometheus"