{{- if $.Values | get "networkPolicies.enabled" false }}
{{- $litellmNs := $.Values | get "litellm.namespace" "litellm" }}
{{- $litellmApp := $.Values | get "litellm.labels.app" "litellm" }}
{{- $anyllmNs := $.Values | get "anythingllm.namespace" "anythingllm" }}
{{- $anyllmApp := $.Values | get "anythingllm.labels.app" "anythingllm" }}
{{- $ingressNs := $.Values | get "ingress.namespace" "ingress-nginx" }}

templates:
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: default-deny-all
      namespace: {{ $litellmNs }}
    spec:
      podSelector: {}
      policyTypes:
        - Ingress
        - Egress
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: allow-dns-egress
      namespace: {{ $litellmNs }}
    spec:
      podSelector: {}
      policyTypes:
        - Egress
      egress:
        - to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
          ports:
            - protocol: UDP
              port: 53
            - protocol: TCP
              port: 53

  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: postgres-policy
      namespace: {{ $litellmNs }}
    spec:
      podSelector:
        matchLabels:
          app.kubernetes.io/name: postgresql
      policyTypes:
        - Ingress
        - Egress
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: {{ $litellmApp }}
          ports:
            - protocol: TCP
              port: 5432

  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: litellm-gateway-policy
      namespace: {{ $litellmNs }}
    spec:
      podSelector:
        matchLabels:
          app.kubernetes.io/name: {{ $litellmApp }}
      policyTypes:
        - Ingress
        - Egress
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: {{ $anyllmNs }}
              podSelector:
                matchLabels:
                  app.kubernetes.io/name: {{ $anyllmApp }}
          ports:
            - protocol: TCP
              port: 4000
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: {{ $ingressNs }}
          ports:
            - protocol: TCP
              port: 4000
        {{- if $.Values | get "agent.installed" false }}
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: {{ $.Values | get "agent.namespace" "agent" }}
              podSelector:
                matchLabels:
                  app: sre-agent
          ports:
          - protocol: TCP
            port: {{ $.Values | get "litellm.servicePort" 4000 }}
        {{- end }}
        {{- if .Values.monitoring.enabled }}
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: monitoring
          ports:
            - protocol: TCP
              port: 4000
        {{- end }}
      egress:
        - to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: postgresql
          ports:
            - protocol: TCP
              port: 5432
        - to:
            - ipBlock:
                cidr: {{ $.Values.secrets.inference.ip }}/32
          ports:
            - protocol: TCP
              port: {{ $.Values.secrets.inference.port }}
{{- end }}
