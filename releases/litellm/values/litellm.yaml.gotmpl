# https://github.com/BerriAI/litellm/blob/v1.83.14-stable/deploy/charts/litellm-helm/values.yaml

{{- with .Values | get "litellm" false }}
{{- $secretName := $.Values | get "litellm.customSecretName" (printf "%s-liteadmin-secrets" ($.Release.Name | trunc 45 | trimSuffix "-")) }}
{{- $extDbEnabled := . | get "externalDb.enabled" false }}

global:
  security:
    allowInsecureImages: {{ not $extDbEnabled }}

strategy:
  type: Recreate

replicaCount: {{ . | get "replicaCount" 1 }}

migrationJob:
  enabled: {{ $extDbEnabled }}
  backoffLimit: 10
  activeDeadlineSeconds: 600
  extraInitContainers:
  - name: wait
    image: {{ $.Values | get "litellm.initContainer.image" "mirror.gcr.io/bitnamilegacy/os-shell:12-debian-12-r16" }}
    securityContext:
      {{- $.Values.security.containerSecurityContext | toYaml | nindent 6 }}
    command:
      - bash
      - -c
      - |
        until echo > /dev/tcp/"$DATABASE_HOST"/"${DATABASE_PORT:-5432}"; do
          echo "Waiting for PostgreSQL at $DATABASE_HOST..."
          sleep 3
        done
    envFrom:
      - secretRef:
          name: {{ $secretName }}

startupProbe:
  path: /health/readiness
  initialDelaySeconds: 15
  periodSeconds: 10
  failureThreshold: 30

livenessProbe:
  path: /health/liveliness
  initialDelaySeconds: 0
  periodSeconds: 10
  timeoutSeconds: 10
  successThreshold: 1
  failureThreshold: 30

readinessProbe:
  path: /health/readiness
  initialDelaySeconds: 0
  periodSeconds: 10
  timeoutSeconds: 10
  successThreshold: 1
  failureThreshold: 30

extraInitContainers:
  - name: wait-for-postgres
    image: {{ $.Values | get "litellm.initContainer.image" "mirror.gcr.io/bitnamilegacy/os-shell:12-debian-12-r16" }}
    securityContext:
      {{- $.Values.security.containerSecurityContext | toYaml | nindent 6 }}
    command:
      - bash
      - -c
      - |
        until echo > /dev/tcp/"$DATABASE_HOST"/"${DATABASE_PORT:-5432}"; do
          echo "Waiting for PostgreSQL at $DATABASE_HOST..."
          sleep 3
        done
    envFrom:
      - secretRef:
          name: {{ $secretName }}

{{- with . | get "liteadmin" false }}
liteadmin:
  storageSize: {{ . | get "storageSize" false }}
  storageClassName: ""
  {{- with . | get "resources" false }}
  resources:
    {{- . | toYaml | nindent 4 }}
  {{- end }}
{{- end }}

{{- with . | get "proxy_config" false }}
proxy_config:
  {{- . | toYaml | nindent 2 }}
{{- end }}

environmentSecrets:
  - {{ $secretName }}

masterkeySecretName: {{ $secretName }}
masterkeySecretKey: "LITELLM_MASTER_KEY"

{{- with . | get "image" false }}
image:
  pullPolicy: {{ . | get "pullPolicy" | default "IfNotPresent" }}
  tag: {{ . | get "tag" false }}
{{- end }}

envVars:
  LITELLM_UI_PATH: "/tmp/litellm-ui"

serviceAccount:
  create: true
  automount: {{ $.Values.security.automountServiceAccountToken }}

podSecurityContext:
  runAsNonRoot: false
  runAsUser: 0
  runAsGroup: 0
  seccompProfile:
    type: RuntimeDefault

securityContext:
  {{- $.Values.security.containerSecurityContext | toYaml | nindent 2 }}

ingress:
  enabled: true
  className: {{ $.Values.internalIngressClass }}
  labels: {}
  annotations:
    cert-manager.io/cluster-issuer: {{ $.Values.certManagerClusterIssuer }}
  hosts:
    - host: api.{{ $.Values.internalDomain }}
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: litellm-tls
      hosts:
        - chat.{{ $.Values.internalDomain }}

postgresql:
  enabled: {{ not $extDbEnabled }}
  architecture: standalone
  {{- if $.Values.security | get "containerSecurityContext.readOnlyRootFilesystem" false }}
  primary:
    containerSecurityContext:
      enabled: true
      readOnlyRootFilesystem: true
  {{- end }}
  serviceAccount:
    create: true
    automountServiceAccountToken: {{ $.Values.security.automountServiceAccountToken }}
  auth:
    existingSecret: {{ $secretName }}
    secretKeys:
      adminPasswordKey: DB_PASSWORD
      userPasswordKey: DB_PASSWORD
  image:
    registry: mirror.gcr.io
    repository: bitnamilegacy/postgresql
    tag: 16.2.0-debian-12-r6
  volumePermissions:
    image:
      registry: mirror.gcr.io
      repository: bitnamilegacy/os-shell
      tag: 12-debian-12-r16
  metrics:
    image:
      registry: mirror.gcr.io
      repository: bitnamilegacy/postgres-exporter
      tag: 0.15.0-debian-12-r14
{{- end }}
