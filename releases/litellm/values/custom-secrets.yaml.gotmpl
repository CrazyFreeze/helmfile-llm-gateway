{{- $appName := $.Release.Name | trimSuffix "-resources" -}}
{{- $secretName := $.Values | get "litellm.customSecretName" (printf "%s-liteadmin-secrets" ($appName | trunc 45 | trimSuffix "-")) -}}
{{- $dbPass := .Values | get "litellm.dbPassword" "litellm-secret-pass" -}}

{{- $extDbEnabled := .Values | get "litellm.externalDb.enabled" false -}}
{{- $dbHost := printf "%s-postgresql.%s.svc.cluster.local" $appName $.Release.Namespace -}}
{{- $dbPort := 5432 -}}
{{- $dbName := "litellm" -}}
{{- $dbUser := "litellm" -}}

{{- if $extDbEnabled -}}
  {{- $dbHost = .Values | get "litellm.externalDb.host" "" -}}
  {{- $dbPort = .Values | get "litellm.externalDb.port" 5432 -}}
  {{- $dbName = .Values | get "litellm.externalDb.database" "litellm" -}}
  {{- $dbUser = .Values | get "litellm.externalDb.username" "litellm" -}}
{{- end -}}

resources:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: {{ $secretName }}
    type: Opaque
    stringData:
      MODEL_API_BASE: {{ .Values | get "litellm.envVars.MODEL_API_BASE" "" | quote }}
      MODEL_API_KEY: {{ .Values | get "litellm.envVars.MODEL_API_KEY" "" | quote }}
      LITELLM_MASTER_KEY: {{ .Values | get "litellm.masterkey" "" | quote }}
      LITELLM_SALT_KEY: {{ .Values | get "litellm.saltkey" "" | quote }}
      DB_PASSWORD: {{ $dbPass | quote }}
      DATABASE_URL: {{ printf "postgresql://%s:%s@%s:%v/%s" $dbUser $dbPass $dbHost $dbPort $dbName | quote }}
      DATABASE_HOST: {{ $dbHost | quote }}
      DISABLE_SCHEMA_UPDATE: {{ $extDbEnabled | toString | quote }}
