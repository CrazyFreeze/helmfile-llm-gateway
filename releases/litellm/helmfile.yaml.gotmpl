---
bases:
  - "../../bases/setup.yaml.gotmpl"
---
repositories:
  - name: bedag
    url: "https://bedag.github.io/helm-charts"

releases:
  - name: litellm-resources
    labels:
      app: {{ .Values | get "litellm.labels.app" "litellm" }}
    chart: bedag/raw
    version: 2.0.2
    installed: {{ .Values | get "litellm.installed" false }}
    namespace: {{ .Values | get "litellm.namespace" "litellm" }}
    {{- if .Values | get "podSecurityStandards.enabled" false }}
    hooks:
      - events: ["postsync"]
        showlogs: false
        command: "kubectl"
        args:
          - "label"
          - "namespace"
          - "{{`{{ .Release.Namespace }}`}}"
          - "--overwrite"
          {{- range $k, $v := .Values.podSecurityStandards.labels }}
          - "{{ $k }}={{ $v }}"
          {{- end }}
    {{- end }}
    values:
      - values/custom-secrets.yaml.gotmpl
      - values/monitoring.yaml.gotmpl
      - values/network-policy.yaml.gotmpl

  - name: litellm
    labels:
      app: {{ .Values | get "litellm.labels.app" "litellm" }}
    chart: oci://ghcr.io/berriai/litellm-helm
    version: 1.83.14-stable
    installed: {{ .Values | get "litellm.installed" false }}
    namespace: {{ .Values | get "litellm.namespace" "litellm" }}
    needs:
      - {{ .Values | get "litellm.namespace" "litellm" }}/litellm-resources
    values:
      - values/litellm.yaml.gotmpl
