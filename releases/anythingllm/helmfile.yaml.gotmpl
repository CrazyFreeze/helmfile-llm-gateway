---
bases:
  - "../../bases/setup.yaml.gotmpl"
---
repositories:
  - name: bedag
    url: "https://bedag.github.io/helm-charts"

releases:
  - name: anythingllm-resources
    labels:
      app: {{ .Values | get "anythingllm.labels.app" "anythingllm" }}
    chart: bedag/raw
    version: 2.0.2
    installed: {{ .Values | get "anythingllm.installed" false }}
    namespace: {{ .Values | get "anythingllm.namespace" "anythingllm" }}
    {{- if .Values | get "podSecurityStandards.enabled" false }}
    hooks:
      - events: ["postsync"]
        showlogs: false
        command: "kubectl"
        args:
          - "label"
          - "namespace"
          - "{{`{{ .Release.Namespace }}`}}"
          - "--overwrite"
          {{- range $k, $v := .Values.podSecurityStandards.labels }}
          - "{{ $k }}={{ $v }}"
          {{- end }}
    {{- end }}
    values:
      - values/secrets.yaml.gotmpl
      - values/network-policy.yaml.gotmpl

  - name: anythingllm
    labels:
      app: {{ .Values | get "anythingllm.labels.app" "anythingllm" }}
    chart: git::https://github.com/Mintplex-Labs/anything-llm@cloud-deployments/helm/charts/anythingllm?ref=v1.20.0
    installed: {{ .Values | get "anythingllm.installed" false }}
    namespace: {{ .Values | get "anythingllm.namespace" "anythingllm" }}
    needs:
      - {{ .Values | get "anythingllm.namespace" "anythingllm" }}/anythingllm-resources
    values:
      - values/anythingllm.yaml.gotmpl
    {{- if .Values | get "anythingllm.mcpServers.enabled" false }}
    strategicMergePatches:
      - apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: anythingllm
        spec:
          template:
            spec:
              volumes:
                - name: mcp-config
                  configMap:
                    name: anythingllm-mcp-config
              containers:
                - name: anythingllm
                  volumeMounts:
                    - name: mcp-config
                      mountPath: /app/server/storage/plugins/anythingllm_mcp_servers.json
                      subPath: anythingllm_mcp_servers.json
    {{- end }}
