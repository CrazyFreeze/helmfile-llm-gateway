{{- $secretName := $.Values | get "anythingllm.customSecretName" (printf "%s-secrets" ($.Release.Name | trimSuffix "-resources" | trunc 53 | trimSuffix "-")) }}
{{- $jwtSecret := .Values | get "anythingllm.jwtSecret" "" -}}
{{- $authToken := .Values | get "anythingllm.authToken" "" -}}

resources:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: {{ $secretName }}
    type: Opaque
    stringData:
      AUTH_TOKEN: {{ $authToken | quote }}
      JWT_SECRET: {{ $jwtSecret | quote }}
      SIG_KEY: {{ $jwtSecret | sha256sum | trunc 32 | quote }}
      SIG_SALT: {{ $authToken | sha256sum | trunc 32 | quote }}
      GENERIC_OPEN_AI_API_KEY: {{ .Values | get "litellm.masterkey" "" | quote }}
      GENERIC_OPEN_AI_EMBEDDING_API_KEY: {{ .Values | get "litellm.masterkey" "" | quote }}
