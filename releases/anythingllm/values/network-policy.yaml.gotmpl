{{- if .Values.networkPolicies.enabled }}
{{- $anyllmNs := $.Values | get "anythingllm.namespace" "anythingllm" }}
{{- $anyllmApp := $.Values | get "anythingllm.labels.app" "anythingllm" }}
{{- $litellmApp := $.Values | get "litellm.labels.app" "litellm" }}
{{- $litellmNs := $.Values | get "litellm.namespace" "litellm" }}
{{- $ingressNs := $.Values | get "ingress.namespace" "ingress-nginx" }}
{{- $agentApp := $.Values | get "agent.labels.app" "sre-agent" }}

templates:
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: default-deny-all
    spec:
      podSelector: {}
      policyTypes:
      - Ingress
      - Egress
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: allow-dns-egress
    spec:
      podSelector: {}
      policyTypes:
      - Egress
      egress:
      - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
        ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: anythingllm-policy
      namespace: {{ $anyllmNs }}
    spec:
      podSelector:
        matchLabels:
          app.kubernetes.io/name: {{ $anyllmApp }}
      policyTypes:
      - Ingress
      - Egress
      ingress:
      - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ $ingressNs }}
        ports:
        - protocol: TCP
          port: {{ $.Values | get "anythingllm.servicePort" nil | default 3001 }}
      egress:
      - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ $litellmNs }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: {{ $litellmApp }}
        ports:
        - protocol: TCP
          port: 4000
      {{- if $.Values | get "agent.installed" false }}
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: {{ $.Values | get "agent.namespace" "agent" }}
            podSelector:
              matchLabels:
                app: {{ $agentApp }}
        ports:
          - protocol: TCP
            port: {{ $.Values | get "agent.servicePort" 8000 }}
      {{- end }}
{{- end }}