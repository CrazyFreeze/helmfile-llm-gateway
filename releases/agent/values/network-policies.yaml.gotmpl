{{- if $.Values | get "networkPolicies.enabled" false }}
{{- $agentNs := $.Values | get "agent.namespace" "agent" }}
{{- $agentApp := $.Values | get "agent.labels.app" "sre-agent" }}
{{- $servicePort := $.Values | get "agent.servicePort" 8000 }}
{{- $llmNs := $.Values | get "litellm.namespace" "litellm" }}
{{- $anyllmApp := $.Values | get "anythingllm.labels.app" "anythingllm" }}
{{- $anyllmNs := $.Values | get "anythingllm.namespace" "anythingllm" }}
{{- $ingressNs := $.Values | get "ingress.namespace" "ingress-nginx" }}

templates:
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: default-deny-all
      namespace: {{ $agentNs }}
    spec:
      podSelector: {}
      policyTypes:
        - Ingress
        - Egress
  - |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: allow-agent-traffic
      namespace: {{ $agentNs }}
    spec:
      podSelector:
        matchLabels:
          app: {{ $agentApp }}
      policyTypes:
        - Ingress
        - Egress
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: {{ $ingressNs }}
          ports:
            - protocol: TCP
              port: {{ $servicePort }}
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: {{ $anyllmNs }}
              podSelector:
                matchLabels:
                  app.kubernetes.io/name: {{ $anyllmApp }}
          ports:
            - protocol: TCP
              port: {{ $servicePort }}
      egress:
        - to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
          ports:
            - protocol: UDP
              port: 53
            - protocol: TCP
              port: 53
        - to:
            - ipBlock:
                cidr: 10.0.0.0/8
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 192.168.0.0/16
          ports:
            - protocol: TCP
              port: 443
            - protocol: TCP
              port: 6443
            - protocol: TCP
              port: 8443
{{- end }}
